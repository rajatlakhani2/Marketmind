# Block config files and hidden runtime data if they are placed in this folder
<FilesMatch "^(marketmind-config|breeze-config)\.php$|^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
